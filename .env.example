# Copy to .env and keep the COMPOSE_FILE line that matches your machine.

# Windows + WSL2 with NVIDIA GPU (services sim, fm)
COMPOSE_FILE=docker-compose.yml:docker-compose.fm.yml:docker-compose.wsl.yml
# Ubuntu (services sim-nvidia, fm-nvidia with an NVIDIA GPU; sim, fm without)
# COMPOSE_FILE=docker-compose.yml:docker-compose.fm.yml

# WSL without an NVIDIA GPU: render on another adapter, or fully in software
# VS_GPU=Intel
# VS_SOFTWARE_GL=1

# VLM detector (detector:=vlm): any OpenAI-compatible server. Default is the compose service
# `ollama` (profile vlm, port 11435); an Ollama already on the host listens on 11434.
# VS_VLM_URL=http://localhost:11435/v1
# VS_VLM_MODEL=qwen3-vl:8b-instruct
# Reuse an existing Ollama model folder instead of downloading again (WSL path)
# VS_OLLAMA_STORE=/mnt/c/Users/<you>/models/ollama

# Use a different value per person if you share a network and do not want to see each other's robots
ROS_DOMAIN_ID=42
