# Copy to .env and keep the line that matches your machine.

# Windows + WSL2 with NVIDIA GPU
COMPOSE_FILE=compose.yaml:compose.wsl.yaml
# Native Ubuntu with NVIDIA GPU
# COMPOSE_FILE=compose.yaml:compose.gpu.yaml:compose.gui-linux.yaml
# Native Ubuntu without NVIDIA GPU (FMs run on CPU, slow)
# COMPOSE_FILE=compose.yaml:compose.gui-linux.yaml

# fm = with PyTorch and foundation models (default), sim = simulation only (~6 GB smaller)
IMAGE_TARGET=fm

# Ollama for the ollama_vlm detector: the compose service (default, port 11435) or an Ollama
# already running on the host, e.g. the Windows service (port 11434)
# VS_OLLAMA_URL=http://localhost:11434
# VLMs pulled by `docker compose --profile vlm up`
# VS_OLLAMA_MODELS=qwen3-vl:8b-instruct gemma4:e4b

# Use a different value per person if you share a network and do not want to see each other's robots
ROS_DOMAIN_ID=42
