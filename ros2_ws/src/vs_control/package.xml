<?xml version="1.0"?>
<package format="3">
  <name>vs_control</name>
  <version>0.1.0</version>
  <description>IBVS controller with hand-eye transform and differential kinematics.</description>
  <maintainer email="eliasbitsch1@gmail.com">Elias Bitsch</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>pinocchio</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>vs_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
